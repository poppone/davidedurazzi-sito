{
  "cleanUrls": true,
  "ignoreCommand": "B=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; git cat-file -e \"$B\" 2>/dev/null || exit 1; git diff --quiet \"$B\" HEAD -- . ':(exclude)stanza' ':(exclude)social' ':(exclude)bozze' ':(exclude).github' ':(exclude)agenti/*.py' ':(exclude)agenti/*.md'",
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/admin.js": {
      "maxDuration": 60
    },
    "api/discord.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/articolo",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>[a-z0-9-]+)"
        }
      ],
      "destination": "/articoli/:slug",
      "permanent": true
    }
  ]
}
